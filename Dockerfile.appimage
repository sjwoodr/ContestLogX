FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Build tools and Qt6 dev packages
RUN apt-get update && apt-get install -y \
    cmake g++ make \
    qt6-base-dev libqt6serialport6-dev qt6-base-dev-tools \
    qt6-gtk-platformtheme \
    libgl1-mesa-dev \
    libfuse2 file wget \
    && rm -rf /var/lib/apt/lists/*

# Download linuxdeploy and Qt plugin
RUN wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
        -O /usr/local/bin/linuxdeploy && \
    chmod +x /usr/local/bin/linuxdeploy && \
    wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
        -O /usr/local/bin/linuxdeploy-plugin-qt && \
    chmod +x /usr/local/bin/linuxdeploy-plugin-qt

COPY . /src
WORKDIR /src

RUN chmod +x scripts/build-appimage.sh

CMD ["scripts/build-appimage.sh"]

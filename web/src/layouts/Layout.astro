---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cross-Platform, fast, clean, modern contest logging for serious operators." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="flex flex-col min-h-screen">
  <!-- Navigation -->
  <nav class="border-b" style="background-color: #161b22; border-color: #30363d;">
    <div class="nav-container">
      <div class="nav-content">
        <a href="/" class="nav-logo">
          <img src="/antenna-white.png" alt="" class="nav-icon" />
          <span>ContestLogX</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links">
          <a href="/" class="nav-link">Home</a>
          <a href="/screenshots" class="nav-link">Screenshots</a>
          <a href="/contests" class="nav-link">Contests</a>
          <a href="/download" class="nav-link">Download</a>
          <a href="/docs" class="nav-link">Docs</a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div class="mobile-menu" id="mobile-menu">
        <a href="/" class="mobile-menu-link">Home</a>
        <a href="/screenshots" class="mobile-menu-link">Screenshots</a>
        <a href="/contests" class="mobile-menu-link">Contests</a>
        <a href="/download" class="mobile-menu-link">Download</a>
        <a href="/docs" class="mobile-menu-link">Docs</a>
      </div>
    </div>
  </nav>

  <script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      const menu = document.getElementById('mobile-menu');
      const btn = document.getElementById('mobile-menu-btn');
      menu?.classList.toggle('open');
      btn?.classList.toggle('open');
    });
  </script>

  <style>
    .nav-container {
      max-width: 56rem;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    .nav-content {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      height: 4rem;
      gap: 2rem;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #e6edf3;
      font-size: 1.25rem;
      font-weight: 700;
      transition: color 0.15s;
    }

    .nav-logo:hover {
      color: #58a6ff;
    }

    .nav-icon {
      height: 1.5rem;
      width: auto;
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
    }

    .nav-link {
      color: #e6edf3;
      transition: color 0.15s;
    }

    .nav-link:hover {
      color: #58a6ff;
    }

    /* Mobile Menu Button */
    .mobile-menu-btn {
      display: none;
      flex-direction: column;
      gap: 4px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      margin-left: auto;
    }

    .mobile-menu-btn span {
      display: block;
      width: 24px;
      height: 2px;
      background-color: #e6edf3;
      transition: all 0.3s;
    }

    .mobile-menu-btn.open span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-menu-btn.open span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-btn.open span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
    }

    /* Mobile Menu */
    .mobile-menu {
      display: none;
      flex-direction: column;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .mobile-menu.open {
      max-height: 300px;
      padding: 1rem 0;
    }

    .mobile-menu-link {
      color: #e6edf3;
      padding: 0.75rem 0;
      transition: color 0.15s;
      border-bottom: 1px solid #30363d;
    }

    .mobile-menu-link:hover {
      color: #58a6ff;
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }

      .mobile-menu-btn {
        display: flex;
      }

      .mobile-menu {
        display: flex;
      }
    }
  </style>

  <!-- Main Content -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-16 py-8 text-center opacity-60 text-sm">
    <p>© 2025-2026 ContestLogX - All Rights Reserved</p>
  </footer>
</body>
</html>

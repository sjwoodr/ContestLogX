---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Supported Contests – ContestLogX">
  <div class="flex flex-col items-center px-5 py-10">

    <div class="max-w-4xl w-full">
      <h1 class="text-4xl font-bold mb-6">Supported Contests</h1>

      <p class="text-lg opacity-80 mb-12">
        ContestLogX supports a wide variety of amateur radio contests through user-defined JSON modules.
      </p>

      <div class="rounded-lg border p-8 mb-8" style="background-color: #161b22; border-color: #30363d;">
        <h2 class="text-2xl font-semibold mb-6">Built-in Contest Modules</h2>

        <div class="overflow-x-auto">
          <table class="w-full text-sm" style="border-collapse: separate; border-spacing: 0;">
            <thead>
              <tr style="border-bottom: 1px solid #30363d;">
                <th class="text-left py-3 pr-6 font-semibold opacity-60 uppercase text-xs tracking-wider">Contest</th>
                <th class="text-left py-3 pr-6 font-semibold opacity-60 uppercase text-xs tracking-wider">Sponsor</th>
                <th class="text-left py-3 pr-6 font-semibold opacity-60 uppercase text-xs tracking-wider">Bands</th>
                <th class="text-left py-3 font-semibold opacity-60 uppercase text-xs tracking-wider">Modes</th>
              </tr>
            </thead>
            <tbody>
              {[
                {
                  name: "7th Call Area QSO Party (7QP)",
                  sponsor: "Western Washington DX Club / Willamette Valley DX Club",
                  bands: "160–10m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.7qp.org/",
                },
                {
                  name: "ARRL 10 Meter Contest",
                  sponsor: "ARRL",
                  bands: "10m",
                  modes: "CW, SSB, Digital",
                  url: "https://contests.arrl.org/contestrules/10-meter-contest-rules/",
                },
                {
                  name: "ARRL International DX Contest",
                  sponsor: "ARRL",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://contests.arrl.org/contestrules/",
                },
                {
                  name: "ARRL Field Day",
                  sponsor: "ARRL",
                  bands: "160–10m, 6m and up",
                  modes: "CW, SSB, FM, Digital",
                  url: "https://www.arrl.org/field-day",
                },
                {
                  name: "ARRL VHF Contest",
                  sponsor: "ARRL",
                  bands: "6m–1mm",
                  modes: "CW, SSB, FM, Digital",
                  url: "https://www.arrl.org/vhf-uh-f-contests",
                },
                {
                  name: "Alabama QSO Party (ALQP)",
                  sponsor: "Alabama Contest Group",
                  bands: "80–10m",
                  modes: "CW, SSB",
                  url: "https://www.alabamacontestgroup.org/",
                },
                {
                  name: "Arkansas QSO Party (ARQP)",
                  sponsor: "Arkansas QSO Party",
                  bands: "160–2m",
                  modes: "CW, SSB, Digital",
                  url: "https://arkqp.com",
                },
                {
                  name: "Atlantic Canada QSO Party (ACQP)",
                  sponsor: "Atlantic Canada QSO Party Committee",
                  bands: "80–10m",
                  modes: "CW, SSB",
                  url: "https://www.acqp.ca/",
                },
                {
                  name: "Canadian Prairies QSO Party (CPQP)",
                  sponsor: "VE6HAMS Calgary Amateur Radio Association",
                  bands: "40–10m",
                  modes: "CW, SSB",
                  url: "https://cpqp.ve6hams.ca",
                },
                {
                  name: "CQ World-Wide WPX Contest",
                  sponsor: "CQ Magazine / WPX Contest Committee",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://www.cqwpx.com/rules.htm",
                },
                {
                  name: "CWops Tests (CWT)",
                  sponsor: "CWops",
                  bands: "160–10m",
                  modes: "CW",
                  url: "https://www.cwops.org/cwt.html",
                },
                {
                  name: "Delaware QSO Party (DEQP)",
                  sponsor: "Delaware QSO Party / FCARC",
                  bands: "160–10m",
                  modes: "CW, SSB, Digital (RTTY/PSK)",
                  url: "https://www.fcarc.club/delaware-qso-party",
                },
                {
                  name: "European Union DX Contest",
                  sponsor: "EU DX Contest Committee",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://eudxcc.altervista.org/",
                },
                {
                  name: "Florida QSO Party (FQP)",
                  sponsor: "Florida Contest Group",
                  bands: "160–10m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.floridaqsoparty.org/",
                },
                {
                  name: "Georgia QSO Party (GAQP)",
                  sponsor: "SECC / SEDXC",
                  bands: "160–6m",
                  modes: "CW, SSB",
                  url: "https://gaqsoparty.com/",
                },
                {
                  name: "His Majesty The King of Spain CW",
                  sponsor: "Unión de Radioaficionados Españoles (URE)",
                  bands: "160–10m",
                  modes: "CW",
                  url: "https://concursos.ure.es/en/his-majesty-the-king-of-spain-cw/",
                },
                {
                  name: "Indiana QSO Party (INQP)",
                  sponsor: "Hoosier DX and Contest Club (HDXCC)",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://www.hdxcc.org/inqp",
                },
                {
                  name: "Japan International DX Contest (JIDX)",
                  sponsor: "Five-Nine Magazine",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://jidx.org/",
                },
                {
                  name: "K1USN Slow Speed Test (SST)",
                  sponsor: "K1USN Radio Club",
                  bands: "160–10m",
                  modes: "CW (≤20 WPM)",
                  url: "https://www.k1usn.com/sst.html",
                },
                {
                  name: "Kentucky QSO Party (KYQP)",
                  sponsor: "Kentucky QSO Party",
                  bands: "80–10m, 6m, 2m",
                  modes: "CW, SSB",
                  url: "https://kyqsoparty.org",
                },
                {
                  name: "Louisiana QSO Party (LAQP)",
                  sponsor: "Louisiana Contest Club",
                  bands: "160–2m",
                  modes: "CW, SSB",
                  url: "https://laqp.org/",
                },
                {
                  name: "Michigan QSO Party (MIQP)",
                  sponsor: "Mad River Radio Club",
                  bands: "80–10m",
                  modes: "CW, SSB",
                  url: "https://www.miqp.org/",
                },
                {
                  name: "Minnesota QSO Party (MNQP)",
                  sponsor: "Minnesota Wireless Assoc. (W0AA)",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://www.w0aa.org/mn-qso-party/",
                },
                {
                  name: "Mississippi QSO Party (MSQP)",
                  sponsor: "Vicksburg Amateur Radio Club",
                  bands: "160–2m",
                  modes: "CW, SSB, RTTY, FT8",
                  url: "https://www.arrlmiss.org/msqp",
                },
                {
                  name: "New England QSO Party (NEQP)",
                  sponsor: "New England QSO Party Committee",
                  bands: "80–10m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.neqp.org",
                },
                {
                  name: "OK-OM DX Contest",
                  sponsor: "Czech Radio Club (ČRK) / SARA",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "http://okomdx.crk.cz/",
                },
                {
                  name: "Missouri QSO Party (MOQP)",
                  sponsor: "BEARS-St. Louis",
                  bands: "160–70cm",
                  modes: "CW, SSB, Digital",
                  url: "https://www.w0ma.org/index.php/missouri-qso-party",
                },
                {
                  name: "New Mexico QSO Party (NMQP)",
                  sponsor: "Amateur Radio Caravan Club",
                  bands: "160–2m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.newmexicoqsoparty.org/",
                },
                {
                  name: "North Dakota QSO Party (NDQP)",
                  sponsor: "ARRL ND Section",
                  bands: "160–2m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.ndarrlsection.com",
                },
                {
                  name: "North American QSO Party (NAQP)",
                  sponsor: "NCJWEB / CQ Magazine",
                  bands: "160–10m",
                  modes: "CW, SSB, RTTY",
                  url: "https://www.ncjweb.com/naqp.html",
                },
                {
                  name: "RAC Canada Day Contest",
                  sponsor: "Radio Amateurs of Canada",
                  bands: "160–2m",
                  modes: "CW, SSB",
                  url: "https://www.rac.ca/contesting-results/",
                },
                {
                  name: "RSGB 3.5 MHz Club Championship",
                  sponsor: "Radio Society of Great Britain",
                  bands: "80m",
                  modes: "CW, SSB, PSK63, RTTY",
                  url: "https://www.rsgbcc.org/hf/rules/2026/r80mcc.shtml",
                },
                {
                  name: "Russian DX Contest (RDXC)",
                  sponsor: "Soyuz Radioljubitelej Rossii (SRR)",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://www.rdxc.org",
                },
                {
                  name: "SP DX Contest",
                  sponsor: "PZK / SP DX Club",
                  bands: "160–10m",
                  modes: "CW, SSB",
                  url: "https://www.spdxcontest.org",
                },
                {
                  name: "UN DX Contest",
                  sponsor: "Kazakhstan Federation of Radio Sports and Radioamateur",
                  bands: "80–10m",
                  modes: "CW, SSB",
                  url: "https://www.qrz.kz/contest/un-dx",
                },
                {
                  name: "Winter Field Day",
                  sponsor: "Winter Field Day Assoc.",
                  bands: "160m–microwave",
                  modes: "CW, SSB, FM, Digital",
                  url: "https://winterfieldday.org",
                },
                {
                  name: "Virginia QSO Party (VAQP)",
                  sponsor: "Sterling Park ARC / Old Dominion DX Assoc.",
                  bands: "160–10m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.qsl.net/sterling/VA_QSO_Party/VQP.html",
                },
                {
                  name: "West Virginia QSO Party (WVQP)",
                  sponsor: "West Virginia State Amateur Radio Council",
                  bands: "80–10m",
                  modes: "CW, SSB, Digital",
                  url: "https://www.qsl.net/wvqp/",
                },
                {
                  name: "YB DX Contest",
                  sponsor: "Indonesian Amateur Radio Society",
                  bands: "80–10m",
                  modes: "SSB",
                  url: "https://ybdxcontest.com/",
                },
                {
                  name: "General Purpose DXCC Log",
                  sponsor: "—",
                  bands: "160–6m",
                  modes: "CW, SSB, RTTY, FT8, FT4",
                  url: null,
                },
              ].map((c, i, arr) => (
                <tr style={i < arr.length - 1 ? "border-bottom: 1px solid #21262d;" : ""}>
                  <td class="py-4 pr-6 font-medium">
                    {c.url
                      ? <a href={c.url} target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: #58a6ff;">{c.name}</a>
                      : c.name}
                  </td>
                  <td class="py-4 pr-6 opacity-70">{c.sponsor}</td>
                  <td class="py-4 pr-6 opacity-70 whitespace-nowrap">{c.bands}</td>
                  <td class="py-4 opacity-70">{c.modes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-lg border p-8" style="background-color: #161b22; border-color: #30363d;">
        <h2 class="text-2xl font-semibold mb-4">Custom Contest Support</h2>
        <p class="leading-relaxed opacity-80 mb-4">
          ContestLogX allows you to define your own contest modules using a simple JSON format.
          This means you can create support for any contest, customizing exchange fields,
          scoring rules, multipliers, and more.
        </p>
        <a href="/contest-module-format" class="underline font-semibold" style="color: #58a6ff;">
          → Contest Module Format Reference
        </a>
      </div>
    </div>

  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Documentation – ContestLogX">
  <div class="flex flex-col items-center px-5 py-10">

    <div class="max-w-4xl w-full">
      <h1 class="text-4xl font-bold mb-6">Documentation</h1>

      <p class="text-lg opacity-80 mb-12">
        Learn how to get the most out of ContestLogX with our comprehensive documentation.
      </p>

      <!-- Documentation sections -->
      <div class="space-y-6">
        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">Getting Started</h2>
          <p class="opacity-80 mb-4">
            Learn the basics of ContestLogX, from installation to your first contest.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>

        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">Rig Control Setup</h2>
          <p class="opacity-80 mb-4">
            Configure flrig integration for seamless rig control and frequency tracking.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>

        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">Creating Custom Contest Modules</h2>
          <p class="opacity-80 mb-4">
            Define your own contests with JSON modules. Learn the format and available options.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>

        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">Keyboard Shortcuts</h2>
          <p class="opacity-80 mb-4">
            Master the keyboard shortcuts for lightning-fast logging during contests.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>

        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">Cabrillo Export</h2>
          <p class="opacity-80 mb-4">
            Export your logs in Cabrillo format for contest submission.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>

        <div class="rounded-lg border p-6" style="background-color: #161b22; border-color: #30363d;">
          <h2 class="text-2xl font-semibold mb-3">CW & SSB Memories</h2>
          <p class="opacity-80 mb-4">
            Set up and use CW and SSB memories with text-to-speech for efficient operation.
          </p>
          <p style="color: #58a6ff;">Coming soon</p>
        </div>
      </div>
    </div>

  </div>
</Layout>

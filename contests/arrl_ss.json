  "ui": {
    "showMultiplierPanel": true,
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "SNs", "PRECs", "CHKs", "EXCHs", "SNr", "PRECr", "CHKr", "EXCHr", "POINTS", "M", "COMMENT"],
    "entryFields": ["CALL", "SNr", "PRECr", "CHKr", "EXCHr"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["160m", "80m", "40m", "20m", "15m", "10m"]
    },
    "multiplierDisplay": {
      "showSections": true
    }
  }
}

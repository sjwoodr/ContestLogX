{
  "contest": {
    "name": "New York QSO Party",
    "abbreviation": "NYQP",
    "version": "1.0.0",
    "sponsor": "New York QSO Party (nyqp.org)",
    "description": "Third Saturday of October, 1400Z to 0159Z (12 hours). NY stations work everyone; everyone else works NY stations. Exchange is RS(T) + NY county (NY stations), state/province (W/VE) or DX. Phone 1 point, CW 2, RTTY/digital 3, each once per band per mode. NY stations count US states, the 62 NY counties and 13 Canadian provinces (125 max; the first NY county also counts as NY; DX earns points only). Everyone else counts the 62 NY counties. Multipliers count once.",
    "startDate": "Third Saturday of October (2026: October 17, 1400Z - 0159Z)",
    "duration": 12,
    "offTimeGapMinutes": 0,
    "modes": [
      "CW",
      "SSB",
      "FM",
      "AM",
      "RTTY",

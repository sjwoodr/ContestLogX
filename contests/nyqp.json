  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "stationType",
      "question": "Select your station location",
      "type": "select",
      "options": [
        {
          "value": "NY",
          "label": "New York - send your NY county"
        },
        {
          "value": "NONNY",
          "label": "Outside New York - send your state, province, or DX"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "NY stations work everyone and count states, counties and provinces. Everyone else works NY stations and counts NY counties."
    },
    {
      "id": "myExchange",
      "question": "Enter your QTH (NY county e.g. MON, state e.g. IN, province e.g. ON, or DX)",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "NY mobiles and portables: change this in Contest Setup when you move to a new county - every station can then be worked again. County-line stations send both counties (DUT/PUT) and both sides log one QSO per county.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    },
    {
      "id": "operatingCategory",
      "question": "Select your entry class",
      "type": "select",
      "options": [
        {
          "value": "FIXED-SO",
          "label": "Fixed - Single Op"
        },
        {
          "value": "FIXED-M1",
          "label": "Fixed - Multi-Single"
        },
        {
          "value": "FIXED-MM",
          "label": "Fixed - Multi-Multi"
        },
        {
          "value": "MOBILE-SO",
          "label": "Mobile - Single Op"
        },
        {
          "value": "MOBILE-M1",
          "label": "Mobile - Multi One"
        },
        {
          "value": "MOBILE-MM",
          "label": "Mobile - Multi-Multi"
        },
        {
          "value": "PORTABLE-SO",
          "label": "Portable - Single Op"
        },
        {
          "value": "PORTABLE-M1",
          "label": "Portable - Multi-One"
        },
        {
          "value": "PORTABLE-MM",
          "label": "Portable - Multi-Multi"
        },
        {
          "value": "SCHOOL-SO",
          "label": "School - Single Op (NY, Mixed, Low Power)"
        },
        {
          "value": "SCHOOL-M1",
          "label": "School - Multi-One (NY, Mixed, Low Power)"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Single-op mode (CW, Phone or Mixed) is set as CATEGORY-MODE in the Cabrillo export; RTTY/digital is allowed in Mixed only. Overlays (ROOKIE, YOUTH12, YOUTH17, YL) are Low Power only. Self-spotting is allowed for Mobile and Portable only."
    },
    {
      "id": "powerCategory",
      "question": "Select your power category",
      "type": "select",
      "options": [
        {
          "value": "HP",
          "label": "High Power (more than 100W)"
        },
        {
          "value": "LP",
          "label": "Low Power (more than 5W, up to 100W)"
        },
        {
          "value": "QRP",
          "label": "QRP (5W or less)"
        }
      ],
      "required": true,
      "storeInMeta": true
    }
  ],
  "exchangeFields": {
    "sent": [
      {
        "name": "RSTs",
        "type": "rst",
        "required": true,
        "description": "Signal report sent"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "NY county, state/province, or DX"
      }
    ],
    "received": [
      {
        "name": "RSTr",
        "type": "rst",
        "required": true,
        "description": "Signal report received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "NY county (from NY stations), state/province, or DX"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": [
        "CW",
        "SSB",
        "FM",
        "AM",
        "RTTY",
        "DIGITAL"
      ],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RSTs",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Rcvd",
      "column": "RSTr",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Rcvd",
      "column": "EXCHr",
      "type": "string",
      "required": true
    },
    {
      "name": "Points",
      "column": "POINTS",
      "type": "number",
      "calculated": true
    },
    {
      "name": "Mult",
      "column": "M",
      "type": "string",
      "calculated": true
    }
  ],
  "scoring": {
    "points": {
      "__comment": "Phone (SSB/FM/AM) 1 point, CW 2 points, RTTY/digital 3 points.",
      "cw": 2,
      "phone": 1,
      "digital": 3
    },
    "multipliers": {
      "__comment": "Counted once. NY stations: 50 states + 62 NY counties + 13 provinces (125 max). The NY state mult is credited automatically once any NY county is worked (the first NY county logged counts as NY as well as a county). DX is a valid exchange worth points but not a multiplier. Non-NY stations: the 62 NY counties.",
      "type": "multsOnce",
      "description": "NY: states, NY counties and provinces. Non-NY: NY counties. Counted once each",
      "categories": [
        "namedMults"
      ],
      "automaticMultipliers": {
        "promptId": "stationType",
        "rules": {
          "NY": [
            "NY"
          ]
        },
        "requiresWorkedFrom": "inStateMults"
      },
      "namedMultsLabels": {
        "NY": "States/Counties/Provinces",
        "NONNY": "NY Counties"
      }
    },
    "finalScore": "SUM(points) * SUM(multipliers)"
  },
  "multAliases": [
    {
      "promptId": "stationType",
      "promptValue": "NY",
      "sourceValues": [
        "DX"
      ],
      "mapsTo": "__NYQPDX__",
      "comment": "DX is a valid exchange for NY stations worth QSO points but not a multiplier. The sentinel is not in namedMults, so no mult is credited."
    }
  ],
  "dupeChecking": {
    "type": "perBandModeAndExchange",
    "description": "Once per band per mode (Phone, CW, RTTY/digital). NY mobiles and portables are new stations in each county, county-line QSOs are logged once per county, and every station is new after your own mobile changes county."
  },
  "logging": {
    "requiredFields": [
      "date",
      "time",
      "frequency",
      "mode",
      "callsign",
      "rstSent",
      "rstReceived",
      "exchSent",
      "exchReceived"
    ],
    "cabrillo": {
      "version": "3.0",
      "contest": "NY-QSO-PARTY",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}",
      "requiredHeaders": [
        "CONTEST",
        "CALLSIGN",
        "LOCATION",
        "CATEGORY-OPERATOR",
        "CATEGORY-ASSISTED",
        "CATEGORY-BAND",
        "CATEGORY-MODE",
        "CATEGORY-POWER",
        "CATEGORY-STATION",
        "CATEGORY-TRANSMITTER",
        "CATEGORY-OVERLAY",
        "CLAIMED-SCORE",
        "CLUB",
        "CREATED-BY",
        "NAME",
        "ADDRESS",
        "ADDRESS-CITY",
        "ADDRESS-STATE-PROVINCE",
        "ADDRESS-POSTALCODE",
        "ADDRESS-COUNTRY",
        "GRID-LOCATOR",
        "EMAIL",
        "OPERATORS",
        "SOAPBOX"
      ],
      "notes": "LOCATION: NY county for NY stations (any county activated, for mobiles/portables), otherwise state, province or DX. Overlays: ROOKIE, YOUTH12, YOUTH17, YL."
    }
  },
  "callHistory": {
    "fieldsToSave": [
      "EXCHr"
    ],
    "description": "Save county/state/province for future autofill"
  },

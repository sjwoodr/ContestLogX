{
  "contest": {
    "name": "Pennsylvania QSO Party",
    "abbreviation": "PAQP",
    "version": "1.0.0",
    "sponsor": "PA QSO Party Association",
    "description": "Second full weekend of October in two sessions: 1600Z Saturday to 0400Z Sunday and 1300Z to 2200Z Sunday. PA stations work everyone; everyone else works PA stations. Exchange is serial number + PA county, ARRL/RAC section, or DX. CW 2 points, Phone 1 point (SSB, FM and AM count as one phone mode). PA stations count ARRL sections, Canadian sections, PA counties and one DX multiplier; everyone else counts the 67 PA counties. Multipliers count once, not per band. QRP doubles QSO points. PA mobiles and rovers earn 500 points for each county with 10 or more QSOs.",
    "startDate": "Second full weekend of October (2026: October 10, 1600Z - October 11, 0400Z and 1300Z - 2200Z)",
    "duration": 21,
    "offTimeGapMinutes": 0,
    "modes": [
      "CW",
      "SSB",
      "FM",
      "AM"
    ],
    "bands": [
      "160m",
      "80m",
      "40m",
      "20m",
      "15m",
      "10m",
      "6m",
      "2m",
      "1.25m",
      "70cm"
    ],
    "url": "https://paqso.org/",
    "sponsorEmail": "info@paqso.org",
    "categories": {
      "stations": [
        "FIXED",
        "PORTABLE",
        "ROVER",
        "MOBILE",
        "COUNTY_LINE"
      ],
      "power": [
        "HIGH",
        "LOW",
        "QRP"
      ],
      "modes": [
        "MIXED",
        "CW",
        "PHONE"
      ]
    }
  },

{
  "contest": {
    "name": "CQ World Wide 160-Meter Contest",
    "abbreviation": "CQ160",
    "version": "1.0.0",
    "sponsor": "CQ Magazine",
    "description": "Top band only. CW is the last full weekend of January, SSB the last full weekend of February, scored as separate contests, each 2200Z Friday to 2200Z Sunday. Exchange is RS(T) + state (USA), province (Canada) or CQ zone (DX - a location only, not a multiplier). 2 points own country, 5 points same continent, 10 points other continent, 5 points maritime mobile. Multipliers once: 48 states + DC, 14 Canadian areas (VO1 and VO2 separate), and DXCC + WAE countries. USA and Canada do not count as countries.",
    "startDate": "CW: last full weekend of January (2026: January 23-25); SSB: last full weekend of February (2026: February 27 - March 1). 2200Z Friday - 2200Z Sunday",
    "duration": 48,
    "offTimeGapMinutes": 30,
    "modes": [
      "CW",
      "SSB"
    ],
    "bands": [
      "160m"
    ],
    "url": "https://cq160.com/rules.htm",
    "categories": {
      "stations": [
        "SINGLE_OP",
        "SINGLE_OP_ASSISTED",
        "MULTI_OP"
      ],
      "power": [
        "HIGH",
        "LOW",
        "QRP"
      ],
      "modes": [
        "CW",
        "SSB"
      ]
    }
  },
  "frequencies": {
    "160m": {
      "start": 1800,
      "end": 2000,
      "cw": {
        "start": 1800,
        "end": 2000
      },
      "phone": {
        "start": 1800,
        "end": 2000
      }
    }
  },
  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "contestMode",
      "question": "Which contest weekend are you entering?",
      "type": "select",
      "options": [
        {
          "value": "CW",
          "label": "CW (last full weekend of January)"
        },
        {
          "value": "SSB",
          "label": "SSB (last full weekend of February)"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "restrictMode": true,
      "description": "CW and SSB are separate contests with separate logs and results. Only the selected mode may be used."
    },
    {
      "id": "myExchange",
      "question": "Enter your QTH (US state, Canadian province, or your CQ zone if DX)",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "USA: state abbreviation (e.g. IN) or DC. Canada: NB NS PE QC ON MB SK AB BC NT YT NU, or NF (VO1) / LB (VO2). Everyone else, including Alaska and Hawaii: your CQ zone number.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    },
    {
      "id": "operatingCategory",
      "question": "Select your operating category",
      "type": "select",
      "options": [
        {
          "value": "SO-HP",
          "label": "(A) Single Operator - High Power (30 hours max)"
        },
        {
          "value": "SO-LP",
          "label": "(B) Single Operator - Low Power, 100W (30 hours max)"
        },
        {
          "value": "QRP",
          "label": "(C) QRP, 5W - assistance allowed (30 hours max)"
        },
        {
          "value": "SOA-HP",
          "label": "(D) Single Operator Assisted - High Power (30 hours max)"
        },
        {
          "value": "SOA-LP",
          "label": "(E) Single Operator Assisted - Low Power, 100W (30 hours max)"
        },
        {
          "value": "MULTI",
          "label": "(F) Multi-Operator - High Power only (40 hours max)"
        },
        {
          "value": "CHECKLOG",
          "label": "Checklog"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Single operators may operate 30 of the 48 hours and multi-op 40, with off-times of at least 30 minutes."
    }
  ],
  "exchangeFields": {
    "sent": [
      {
        "name": "RST",
        "type": "rst",
        "required": true,
        "description": "Signal report sent (599 CW / 59 SSB)"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "Your state, province, or CQ zone (DX)"
      }
    ],
    "received": [
      {
        "name": "RST",
        "type": "rst",
        "required": true,
        "description": "Signal report received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "State (USA), province (Canada) or CQ zone (DX)"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": [
        "CW",
        "SSB"
      ],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RSTs",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Rcvd",
      "column": "RSTr",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Rcvd",
      "column": "EXCHr",
      "type": "string",
      "required": true
    },
    {
      "name": "Points",
      "column": "POINTS",
      "type": "number",
      "calculated": true
    },
    {
      "name": "Mult",
      "column": "M",
      "type": "string",
      "calculated": true
    }
  ],
  "scoring": {
    "mobilePoints": 5,
    "mobileSuffixes": [
      "/MM"
    ],
    "points": {
      "__comment": "2 points own country, 5 points same continent, 10 points other continent. Maritime mobile (/MM) is 5 points via mobilePoints and earns no multiplier.",
      "sameDxccEntity": {
        "CW": 2,
        "SSB": 2
      },
      "sameContinent": {
        "CW": 5,
        "SSB": 5
      },
      "differentContinent": {
        "CW": 10,
        "SSB": 10
      }
    },
    "precedence": [
      "sameDxccEntity",
      "sameContinent",
      "differentContinent"
    ],
    "multipliers": {
      "__comment": "Once for the contest: namedMults (48 states + DC + 14 Canadian areas) from EXCHr, plus DXCC + WAE countries. usAndCanadaCountDxcc false: W and VE count only as their state/province. AK and HI are countries (they send a zone, or AK/HI, which map to a sentinel). DX zones map to the same sentinel, so a zone is never a multiplier.",
      "type": "multsOnce",
      "description": "US states + DC, Canadian areas and DX countries, each counted once",
      "categories": [
        "namedMults",
        "dxcc"
      ],
      "includeWaeEntities": true,
      "usAndCanadaCountDxcc": false,
      "alaskaAndHawaiiCountDxcc": false,
      "namedMultsLabel": "States/Provinces"
    },
    "finalScore": "SUM(points) * (namedMults + dxccMultipliers)"
  },
  "dupeChecking": {
    "type": "overall",
    "description": "Each station may be worked once (one band, one mode per contest)"
  },
  "logging": {
    "requiredFields": [
      "date",
      "time",
      "frequency",
      "mode",
      "callsign",
      "rstSent",
      "rstReceived",
      "exchSent",
      "exchReceived"
    ],
    "cabrillo": {
      "version": "3.0",
      "contest": "CQ-160-CW",
      "contestMapping": {
        "CW": "CQ-160-CW",
        "SSB": "CQ-160-SSB"
      },
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {EXCHs} {call} {rst_rcvd} {EXCHr}",
      "requiredHeaders": [
        "CONTEST",
        "CALLSIGN",
        "LOCATION",
        "CATEGORY-OPERATOR",
        "CATEGORY-ASSISTED",
        "CATEGORY-BAND",
        "CATEGORY-MODE",
        "CATEGORY-POWER",
        "CATEGORY-TRANSMITTER",
        "CLAIMED-SCORE",
        "CLUB",
        "CREATED-BY",
        "NAME",
        "ADDRESS",
        "EMAIL",
        "OPERATORS",
        "SOAPBOX"
      ]
    }
  },
  "callHistory": {
    "fieldsToSave": [
      "EXCHr"
    ],
    "description": "Save state/province/zone for future autofill"
  },

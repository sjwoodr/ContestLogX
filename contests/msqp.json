    "exchangeValidation": {
      "type": "namedMultOrDxcc",
      "description": "MS county (3 letters), US state (2 letters), Canadian province (2 letters), DXCC entity prefix, or 4-character Maidenhead grid square for FT4/8."
    },
    "receivedExchangeFilter": {
      "promptId": "stationType",
      "rules": {
        "WVE": "inStateMults",
        "DX":  "inStateMults"
      }
    }
  },


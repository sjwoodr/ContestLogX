      "AB", "BC", "MB", "NB", "NL", "NS", "NT", "NU", "ON", "PE", "QC", "SK", "YT"
    ],
    "inStateMults": [
      "ADA", "ALC", "AMI", "ATT", "BEN", "BOL", "CAL", "CAR",
      "CHI", "CHO", "CLA", "CLB", "CLK", "COA", "COP", "COV",
      "DES", "FOR", "FRA", "GEO", "GRE", "GRN", "HAN", "HAR",
      "HIN", "HOL", "HUM", "ISS", "ITA", "JAC", "JAS", "JDV",
      "JEF", "JON", "KEM", "LAF", "LAM", "LAU", "LAW", "LEA",
      "LEE", "LEF", "LIN", "LOW", "MAD", "MAR", "MGY", "MON",
      "MRN", "NES", "NEW", "NOX", "OKT", "PAN", "PEA", "PER",

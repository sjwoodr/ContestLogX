      "SE01", "SE02", "SE03", "SE04", "SE05", "SE06", "SE07", "SE08", "SE09", "SE10",
      "SE11", "SE12", "SE13", "SE14", "SE15", "SE16", "SE17", "SE18", "SE19", "SE20", "SE21"
    ],
    "exchangeValidation": {
      "type": "namedMultOrSerial",
      "description": "EU stations send region code, non-EU stations send ITU zone number",
      "serialNumberFormat": "^[0-9]{1,3}$",
      "logic": "Accept if value matches a named multiplier OR matches serialNumberFormat"
    }
  },
  "ui": {
    "showMultiplierPanel": true,
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "RSTs", "RSTr", "EXCHs", "EXCHr", "POINTS", "M", "COMMENT"],
    "entryFields": ["CALL", "RSTr", "EXCHr"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["160m", "80m", "40m", "20m", "15m", "10m"]
    },
    "multiplierDisplay": {
      "showRegions": true,
      "showDXCC": true
    }
  }
}

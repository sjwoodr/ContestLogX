      "FI01", "FI02", "FI03", "FI04", "FI05", "FI06", "FI07", "FI08", "FI09", "FI10",
      "FI11", "FI12", "FI13", "FI14", "FI15", "FI16", "FI17", "FI18", "FI19",
      "FR01", "FR02", "FR03", "FR04", "FR05", "FR06", "FR07", "FR08", "FR09", "FR10",
      "FR11", "FR12", "FR13", "FR14", "FR15", "FR16", "FR17", "FR18", "FR19", "FR20",
      "DE01", "DE02", "DE03", "DE04", "DE05", "DE06", "DE07", "DE08", "DE09", "DE10",
      "DE11", "DE12", "DE13", "DE14", "DE15", "DE16",
      "GR01", "GR02", "GR03", "GR04", "GR05", "GR06", "GR07", "GR08", "GR09", "GR10",
      "GR11", "GR12", "GR13",
      "HU01", "HU02", "HU03", "HU04", "HU05", "HU06", "HU07",
      "IE01", "IE02", "IE03", "IE04",
      "IT01", "IT02", "IT03", "IT04", "IT05", "IT06", "IT07", "IT08", "IT09", "IT10",
      "IT11", "IT12", "IT13", "IT14", "IT15", "IT16", "IT17", "IT18", "IT19", "IT20", "IT21",
      "LV01", "LV02", "LV03", "LV04", "LV05", "LV06",
      "LT01", "LT02", "LT03", "LT04", "LT05",
      "LX01",

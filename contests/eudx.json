      "NL11", "NL12", "NL13",
      "PL01", "PL02", "PL03", "PL04", "PL05", "PL06", "PL07", "PL08", "PL09", "PL10",
      "PL11", "PL12", "PL13", "PL14", "PL15", "PL16",
      "PT01", "PT02", "PT03", "PT04", "PT05", "PT06", "PT07",
      "RO01", "RO02", "RO03", "RO04", "RO05", "RO06", "RO07", "RO08",
      "SK01", "SK02", "SK03", "SK04", "SK05", "SK06", "SK07", "SK08",
      "SI01", "SI02", "SI03", "SI04", "SI05", "SI06",
      "ES01", "ES02", "ES03", "ES04", "ES05", "ES06", "ES07", "ES08", "ES09", "ES10",

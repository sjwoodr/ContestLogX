    ]
  },
  "ui": {
    "showMultiplierPanel": true,
    "logColumns": [
      "DATE",
      "TIME",
      "CALL",
      "FREQ",
      "MODE",
      "SNs",
      "SNr",
      "NAMEr",
      "EXCHr",
      "POINTS",
      "M",
      "COMMENT"
    ],
    "entryFields": [
      "CALL",
      "SNr",
      "NAMEr",
      "EXCHr"
    ],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": [
        "80m",
        "40m",
        "20m"
      ]
    },
    "multiplierDisplay": {
      "showStates": true,
      "showProvinces": true,
      "showDXCC": true
    }
  }
}

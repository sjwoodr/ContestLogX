{
  "contest": {
    "name": "Illinois QSO Party",
    "abbreviation": "ILQP",
    "version": "1.0.0",
    "sponsor": "Western Illinois Amateur Radio Club (W9AWE)",
    "description": "Third Sunday of October, 1700Z to 0100Z. IL stations work everyone; everyone else works IL stations. Exchange is RS(T) + IL county (IL stations) or state/province/country. Phone 1 point, CW/digital 2 points; FT8 and FT4 earn no credit. Once per band and mode (phone, CW/digital), and once per band/mode/county for IL mobiles, rovers and county lines. IL stations count IL counties, US states, Canadian provinces and up to 5 DXCC countries; everyone else counts the 102 IL counties. 100-point bonus each for working W9AWE and W9OAB.",
    "startDate": "Third Sunday of October (2025: October 19, 1700Z - 0100Z)",
    "duration": 8,
    "offTimeGapMinutes": 0,
    "modes": [
      "CW",
      "SSB",
      "FM",
      "RTTY",
      "DIGITAL"
    ],
    "excludedModes": [
      "FT8",
      "FT4"
    ],
    "bands": [
      "160m",
      "80m",
      "40m",
      "20m",
      "15m",
      "10m",
      "6m",
      "2m"
    ],
    "url": "https://w9awe.org/ilqp/",
    "sponsorEmail": "n9jf@arrl.net",
    "__sponsorContact_comment": "Questions and logs",
    "categories": {
      "stations": [
        "FIXED",
        "PORTABLE",
        "MOBILE",
        "ROVER",
        "UNLIMITED"
      ],
      "power": [
        "HIGH",
        "LOW",
        "QRP"
      ],
      "modes": [
        "MIXED",
        "CW",
        "PHONE"
      ]
    }
  },

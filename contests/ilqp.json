  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "stationType",
      "question": "Select your station location",
      "type": "select",
      "options": [
        {
          "value": "IL",
          "label": "Illinois - send your IL county"
        },
        {
          "value": "WVE",
          "label": "W/VE (US or Canada outside Illinois) - send state or province"
        },
        {
          "value": "DX",
          "label": "DX (outside US/Canada) - send your country (DXCC prefix)"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "IL stations work everyone and count counties, states, provinces and up to 5 DX countries. Everyone else works IL stations and counts IL counties."
    },
    {
      "id": "myExchange",
      "question": "Enter your QTH (IL county e.g. ADAM, state e.g. IN, province e.g. ON, or DXCC prefix e.g. DL)",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "IL mobiles and rovers: change this in Contest Setup when you move to a new county - every station can then be worked again. County-line and corner stations: log one QSO per county.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    },
    {
      "id": "operatingCategory",
      "question": "Select your entry class",
      "type": "select",
      "options": [
        {
          "value": "IL-FIXED-HP",
          "label": "IL Fixed Station - High Power (>100W PEP)"
        },
        {
          "value": "IL-FIXED-LP",
          "label": "IL Fixed Station - Low Power (100W PEP or less)"
        },
        {
          "value": "IL-PORTABLE",
          "label": "Illinois Portable"
        },
        {
          "value": "IL-MOBILE",
          "label": "Illinois Mobile"
        },
        {
          "value": "IL-ROVER",
          "label": "Illinois Rover"
        },
        {
          "value": "OUT-HP",
          "label": "Outside Illinois - High Power"
        },
        {
          "value": "OUT-LP",
          "label": "Outside Illinois - Low Power"
        },
        {
          "value": "UNLIMITED",
          "label": "Unlimited (multiple transmitted signals, single site)"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "QRP (5W or less at all times) is claimed by marking QRP as the power category in the Cabrillo export. Self-spotting is allowed in all classes."
    }
  ],
  "exchangeFields": {
    "sent": [
      {
        "name": "RSTs",
        "type": "rst",
        "required": true,
        "description": "Signal report sent"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "IL county, state/province, or country"
      }
    ],
    "received": [
      {
        "name": "RSTr",
        "type": "rst",
        "required": true,
        "description": "Signal report received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "IL county (from IL stations), state/province, or country prefix"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": [
        "CW",
        "SSB",
        "FM",
        "RTTY",
        "DIGITAL"
      ],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RSTs",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Rcvd",
      "column": "RSTr",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Rcvd",
      "column": "EXCHr",
      "type": "string",
      "required": true
    },
    {
      "name": "Points",
      "column": "POINTS",
      "type": "number",
      "calculated": true
    },
    {
      "name": "Mult",
      "column": "M",
      "type": "string",
      "calculated": true
    }
  ],
  "scoring": {
    "points": {
      "__comment": "Phone 1 point, CW and digital 2 points. FT8/FT4 earn no credit (contest.excludedModes).",
      "cw": 2,
      "phone": 1,
      "digital": 2
    },
    "multipliers": {
      "__comment": "Counted once. IL stations: 102 IL counties + US states (incl. AK/HI - KH6/KL7 are not DX) + 13 Canadian provinces + DXCC countries, at most 5 DX counted (maxDxccMultipliers). Canada, KH6 and KL7 do not count as DX. Non-IL stations: the 102 IL counties.",
      "type": "multsOnce",
      "description": "IL: counties, states, provinces and up to 5 DXCC. Non-IL: IL counties. Counted once each",
      "categories": [
        "namedMults"
      ],
      "maxDxccMultipliers": 5,
      "stationClassMultipliers": {
        "IL": [
          "namedMults",
          "dxcc"
        ],
        "WVE": [
          "namedMults"
        ],
        "DX": [
          "namedMults"
        ]
      },
      "namedMultsLabels": {
        "IL": "Counties/States/Provinces",
        "WVE": "IL Counties",
        "DX": "IL Counties"
      },
      "alaskaAndHawaiiCountDxcc": false,
      "usAndCanadaCountDxcc": false,
      "namedMultsRequireWveCallsign": true
    },
    "finalScore": "SUM(points) * (namedMults + MIN(dxccMultipliers, 5)) + bonus"
  },
  "bonusStations": [
    {
      "name": "W9AWE",
      "pointsEach": 100,
      "type": "bonusOnce",
      "stations": [
        "W9AWE"
      ],
      "note": "Sponsoring club's historical call (mostly CW). 100 points, once."
    },
    {
      "name": "W9OAB",
      "pointsEach": 100,
      "type": "bonusOnce",
      "stations": [
        "W9OAB"
      ],
      "note": "Sponsoring club's second call (mostly phone). 100 points, once."
    }
  ],
  "dupeChecking": {
    "type": "perBandModeAndExchange",
    "cwDigitalSameMode": true,
    "description": "Once per band and mode, where the modes are phone and CW/digital (CW and digital are the same mode). IL mobiles, rovers and county-line stations are new in each county, and every station is new after your own mobile or rover changes county."
  },
  "logging": {
    "requiredFields": [
      "date",
      "time",
      "frequency",
      "mode",
      "callsign",
      "rstSent",
      "rstReceived",
      "exchSent",
      "exchReceived"
    ],
    "cabrillo": {
      "version": "3.0",
      "contest": "IL-QSO-PARTY",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}",
      "requiredHeaders": [
        "CONTEST",
        "CALLSIGN",
        "LOCATION",
        "CATEGORY-OPERATOR",
        "CATEGORY-POWER",
        "CATEGORY-MODE",
        "CATEGORY-STATION",
        "CATEGORY-TRANSMITTER",
        "CLAIMED-SCORE",
        "CLUB",
        "CREATED-BY",
        "NAME",
        "ADDRESS",
        "EMAIL",
        "OPERATORS",
        "SOAPBOX"
      ],
      "notes": "Email the Cabrillo file to the log checker listed on the ILQP site; do not send ADIF."
    }
  },
  "callHistory": {
    "fieldsToSave": [
      "EXCHr"
    ],
    "description": "Save county/state/province for future autofill"
  },

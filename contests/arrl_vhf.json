      "cw": {"start": 50000, "end": 50100},
      "ssb": {"start": 50100, "end": 50300},
      "fm": {"start": 52525, "end": 52625}
    },
    "2m": {
      "start": 144000,
      "end": 148000,
      "cw": {"start": 144000, "end": 144100},

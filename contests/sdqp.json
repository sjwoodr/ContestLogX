        "start": 420000,
        "end": 450000
      }
    }
  },
  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "stationType",
      "question": "Select your station location",
      "type": "select",
      "options": [
        {
          "value": "SD",
          "label": "South Dakota - send your SD county"
        },
        {
          "value": "WVE",
          "label": "W/VE (US or Canada outside SD) - send state or province"
        },
        {
          "value": "DX",
          "label": "DX (outside US/Canada) - send your DXCC country prefix"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "SD stations work everyone and count counties, states, provinces and DXCC. Everyone else works SD stations and counts SD counties."
    },
    {
      "id": "myExchange",
      "question": "Enter your exchange (SD county e.g. MINN, state e.g. IN, province e.g. ON, or DXCC prefix e.g. DL)",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "SD rovers/portables: change this in Contest Setup when you move to a new county - every station can then be worked again. County-line stations: log one QSO per county.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    },
    {
      "id": "operatingCategory",
      "question": "Select your class",
      "type": "select",
      "options": [
        {
          "value": "SD-SO-FIXED",
          "label": "In-State Single-Op Fixed"
        },
        {
          "value": "SD-MO-FIXED",
          "label": "In-State Multi-Op Fixed"
        },
        {
          "value": "SD-SO-ROVER",
          "label": "In-State Single-Op Rover/Portable"
        },
        {
          "value": "SD-MO-ROVER",
          "label": "In-State Multi-Op Rover/Portable"
        },
        {
          "value": "OUT-SO",
          "label": "Out of State Single-Op Fixed"
        },
        {
          "value": "DX-SO",
          "label": "DX Single-Op (any mode and power)"
        }
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Classes other than DX also pick a mode (CW, Phone or Mixed - set CATEGORY-MODE in the Cabrillo export) and power."
    },
    {
      "id": "powerCategory",
      "question": "Select your power category",
      "type": "select",
      "options": [
        {
          "value": "HP",
          "label": "High Power (more than 150W)"
        },
        {
          "value": "LP",
          "label": "Low Power (150W or less)"
        },
        {
          "value": "QRP",
          "label": "QRP (5W or less)"
        }
      ],
      "required": true,
      "storeInMeta": true
    }
  ],
  "exchangeFields": {
    "sent": [
      {
        "name": "RSTs",
        "type": "rst",
        "required": true,
        "description": "Signal report sent"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "SD county, state/province, or DXCC prefix"
      }
    ],
    "received": [
      {
        "name": "RSTr",
        "type": "rst",
        "required": true,
        "description": "Signal report received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "SD county (from SD stations), state/province (W/VE) or DXCC prefix (DX)"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": [
        "CW",
        "SSB",
        "FM"
      ],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RSTs",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Rcvd",
      "column": "RSTr",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true
    },
    {
      "name": "Exch Rcvd",
      "column": "EXCHr",
      "type": "string",
      "required": true
    },
    {
      "name": "Points",
      "column": "POINTS",
      "type": "number",
      "calculated": true
    },
    {
      "name": "Mult",
      "column": "M",
      "type": "string",
      "calculated": true
    }
  ],
  "scoring": {
    "points": {
      "__comment": "CW 2 points, Phone (SSB/FM) 1 point.",
      "cw": 2,
      "phone": 1
    },
    "multipliers": {
      "__comment": "Counted once for the contest. SD stations: SD counties + US states + Canadian provinces/territories + DXCC countries (US/Canada count only as their state/province; DC counts as MD). Non-SD stations: the 66 SD counties.",
      "type": "multsOnce",
      "description": "SD: counties, states, provinces and DXCC. Non-SD: SD counties. Counted once each",
      "categories": [
        "namedMults"
      ],
      "stationClassMultipliers": {
        "SD": [
          "namedMults",
          "dxcc"
        ],
        "WVE": [
          "namedMults"
        ],
        "DX": [
          "namedMults"
        ]
      },
      "namedMultsLabels": {
        "SD": "Counties/States/Provinces",
        "WVE": "SD Counties",
        "DX": "SD Counties"
      },
      "alaskaAndHawaiiCountDxcc": false,
      "usAndCanadaCountDxcc": false
    },
    "finalScore": "SUM(points) * SUM(multipliers) + bonus"
  },
  "bonusStations": [
    {
      "name": "Sponsoring club W0OJY",
      "pointsEach": 100,
      "type": "bonusOnce",
      "stations": [
        "W0OJY"
      ],
      "note": "One-time 100-point bonus for working the sponsoring club station W0OJY on any band or mode. Further W0OJY QSOs count normally."
    }
  ],
  "dupeChecking": {
    "type": "perBandModeAndExchange",
    "description": "Once per band per mode (SSB and FM are one phone mode). SD rovers/portables are new contacts in each county, county-line contacts are logged once per county, and every station is new after your own rover changes county."
  },
  "logging": {
    "requiredFields": [
      "date",
      "time",
      "frequency",
      "mode",
      "callsign",
      "rstSent",
      "rstReceived",
      "exchSent",
      "exchReceived"
    ],
    "cabrillo": {
      "version": "3.0",
      "contest": "SD-QSO-PARTY",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}",
      "requiredHeaders": [
        "CONTEST",
        "CALLSIGN",
        "LOCATION",
        "CATEGORY-OPERATOR",
        "CATEGORY-POWER",
        "CATEGORY-MODE",
        "CATEGORY-STATION",
        "CLAIMED-SCORE",
        "CLUB",
        "CREATED-BY",
        "NAME",
        "ADDRESS",
        "EMAIL",
        "OPERATORS",
        "SOAPBOX"
      ]
    }
  },
  "callHistory": {
    "fieldsToSave": [
      "EXCHr"
    ],
    "description": "Save county/state/province/DXCC prefix for future autofill"
  },

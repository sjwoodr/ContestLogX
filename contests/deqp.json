{
  "contest": {
    "name": "Delaware QSO Party",
    "abbreviation": "DEQP",
    "version": "1.0.0",
    "sponsor": "Delaware QSO Party / FCARC",
    "description": "Delaware QSO Party — first full weekend of May. Delaware stations work everyone; non-Delaware stations work Delaware stations only. CW, Phone (SSB), and Digital (RTTY/PSK). FT8/FT4/WSJT modes are NOT logged in ContestLogX — they use a Field Day-style exchange (e.g., 1A DE, 1A AZ) and per the contest rules must be submitted in a separate Cabrillo log generated by WSJT-X.",
    "startDate": "First full weekend of May (2026: May 2-3)",
    "duration": 24,
    "offTimeGapMinutes": 0,
    "modes": ["CW", "SSB", "DIGITAL"],
    "bands": ["160m", "80m", "40m", "20m", "15m", "10m"],
    "url": "https://www.fcarc.club/delaware-qso-party",
    "categories": {
      "stations": ["SINGLE_OP", "MULTI_OP", "MOBILE", "PORTABLE", "ROVER"],
      "power": ["LOW_POWER", "QRP", "HIGH_POWER"],
      "modes": ["MIXED", "CW", "PHONE", "DIGITAL"]
    }
  },
  "contestOnlineScore": {
    "contestId": "DEQP",
    "mult1Name": "Counties / States / Prov.",
    "mult1Attribute": "exchange"
  },
  "frequencies": {
    "160m": {
      "start": 1800, "end": 2000,
      "cw":    {"start": 1800, "end": 1850},
      "phone": {"start": 1850, "end": 2000}
    },
    "80m": {
      "start": 3500, "end": 4000,
      "cw":    {"start": 3500, "end": 3600},
      "phone": {"start": 3600, "end": 4000}
    },
    "40m": {
      "start": 7000, "end": 7300,
      "cw":    {"start": 7000, "end": 7125},
      "phone": {"start": 7125, "end": 7300}
    },
    "20m": {
      "start": 14000, "end": 14350,
      "cw":    {"start": 14000, "end": 14150},
      "phone": {"start": 14150, "end": 14350}
    },
    "15m": {
      "start": 21000, "end": 21450,
      "cw":    {"start": 21000, "end": 21200},
      "phone": {"start": 21200, "end": 21450}
    },
    "10m": {
      "start": 28000, "end": 29700,
      "cw":    {"start": 28000, "end": 28300},
      "phone": {"start": 28300, "end": 29700}
    }
  },
  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "stationType",
      "question": "Select your station location",
      "type": "select",
      "options": [
        {"value": "DE",      "label": "Delaware (in-state)"},
        {"value": "OUTSIDE", "label": "Outside Delaware (W / VE / other)"},
        {"value": "DX",      "label": "DX (outside W / VE)"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Delaware stations work everyone; non-Delaware stations work Delaware stations only. DE-DE QSOs earn QSO points but do not credit a multiplier."
    },
    {
      "id": "operatingClass",
      "question": "Select your operating class",
      "type": "select",
      "options": [
        {"value": "SO",  "label": "Single Operator"},
        {"value": "MS",  "label": "Multi-Op Single Transmitter (Multi-Multi is not permitted per DEQP rules)"},
        {"value": "MOB", "label": "Mobile (Delaware stations only)"},
        {"value": "POR", "label": "Portable (Delaware stations only)"},
        {"value": "ROV", "label": "Rover (Delaware stations only)"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "DEQP allows Single-Op and Multi-Single only. Self-spotting is permitted in all categories. Power category is selected separately below."
    },
    {
      "id": "powerCategory",
      "question": "Select your power level (applies a final-score multiplier per DEQP rules)",
      "type": "select",
      "options": [
        {"value": "HP",  "label": "High Power (> 100 W) — final score × 1"},
        {"value": "LP",  "label": "Low Power (≤ 100 W) — final score × 2"},
        {"value": "QRP", "label": "QRP (≤ 5 W) — final score × 3"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Logs without an indicated power level are scored as > 100 W (×1)."
    },
    {
      "id": "myExchange",
      "question": "Enter your exchange. Delaware stations: county code (NDE = New Castle, KDE = Kent, SDE = Sussex). Non-Delaware W/VE: 2-letter state/province code. DX: DX.",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "3-letter NDE/KDE/SDE for Delaware stations; 2-letter state/province for non-Delaware W/VE; DX otherwise.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    }
  ],
  "exchangeFields": {
    "sent": [
      {
        "name": "RSTs",
        "type": "rst",
        "required": true,
        "description": "Signal report sent (default 599 CW / 59 Phone)"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "NDE/KDE/SDE for Delaware; 2-letter state/province for non-Delaware W/VE; DX otherwise"
      }
    ],
    "received": [
      {
        "name": "RSTr",
        "type": "rst",
        "required": true,
        "description": "Signal report received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "NDE/KDE/SDE from Delaware stations; 2-letter state/province from W/VE; DX from others"
      }
    ]
  },
  "qsoFields": [
    {"name": "Date",      "column": "DATE",  "type": "date", "format": "yyyy-MM-dd", "required": true},
    {"name": "Time",      "column": "TIME",  "type": "time", "format": "HH:mm:ss",   "required": true},
    {"name": "Callsign",  "column": "CALL",  "type": "string", "required": true, "uppercase": true},
    {"name": "Frequency", "column": "FREQ",  "type": "number", "unit": "kHz", "required": true},
    {"name": "Mode",      "column": "MODE",  "type": "enum", "values": ["CW", "SSB", "DIGITAL"], "required": true},
    {"name": "RST Sent",     "column": "RSTs", "type": "rst", "required": true, "description": "Signal report sent"},
    {"name": "RST Received", "column": "RSTr", "type": "rst", "required": true, "description": "Signal report received"},
    {"name": "Exchange Sent",     "column": "EXCHs", "type": "string", "required": true, "description": "Exchange sent"},
    {"name": "Exchange Received", "column": "EXCHr", "type": "string", "required": true, "description": "Exchange received"},
    {"name": "Points",     "column": "POINTS", "type": "number", "calculated": true},
    {"name": "Multiplier", "column": "M",      "type": "string", "calculated": true}
  ],
  "scoring": {
    "points": {
      "sameDxccEntity": {
        "CW":      20,
        "SSB":     10,
        "DIGITAL": 20,
        "byPrompt": {
          "stationType": {
            "DE": {"CW": 2, "SSB": 1, "DIGITAL": 2}
          }
        }
      },
      "differentDxccEntity": {
        "CW":      20,
        "SSB":     10,
        "DIGITAL": 20,
        "byPrompt": {
          "stationType": {
            "DE": {"CW": 2, "SSB": 1, "DIGITAL": 2}
          }
        }
      },
      "sameContinent": {
        "CW":      20,
        "SSB":     10,
        "DIGITAL": 20,
        "byPrompt": {
          "stationType": {
            "DE": {"CW": 2, "SSB": 1, "DIGITAL": 2}
          }
        }
      },
      "differentContinent": {
        "CW":      20,
        "SSB":     10,
        "DIGITAL": 20,
        "byPrompt": {
          "stationType": {
            "DE": {"CW": 2, "SSB": 1, "DIGITAL": 2}
          }
        }
      }
    },
    "precedence": [
      "sameDxccEntity",
      "differentDxccEntity",
      "sameContinent",
      "differentContinent"
    ],
    "scoreMultiplier": {
      "promptId": "powerCategory",
      "values": {
        "HP":  1,
        "LP":  2,
        "QRP": 3
      }
    },
    "multipliers": {
      "type": "multsPerBand",
      "description": "Multipliers count once per band. Non-Delaware stations multiply by Delaware counties (NDE/KDE/SDE — max 3 per band). Delaware stations multiply by US states (49, excluding DE itself) + 13 Canadian provinces + DXCC entities. DE-DE QSOs earn point credit but don't credit a county multiplier (DE op's namedMults list doesn't contain NDE/KDE/SDE; DXCC for self-DXCC is also not credited).",
      "categories": ["namedMults", "dxcc"],
      "alaskaAndHawaiiCountDxcc": false,
      "usAndCanadaCountDxcc": false,
      "stationClassMultipliers": {
        "DE":      ["namedMults", "dxcc"],
        "OUTSIDE": ["namedMults"],
        "DX":      ["namedMults"]
      }
    },
    "finalScore": "SUM(points) * powerMultiplier * SUM(multipliers)"
  },
  "dupeChecking": {
    "type": "perBandAndMode",
    "description": "A station may be worked once per CW, once per SSB, and once per Digital on each band — three modes per band. Delaware mobiles that change counties are considered new stations and may be re-worked for both QSO and multiplier credit. County-line QSOs should be logged as two separate QSOs."
  },
  "multAliases": [
    {
      "promptId": "stationType",
      "promptValue": "DE",
      "sourceList": "inStateMults",
      "mapsTo": "__DEDESUPPRESS__",
      "comment": "DEQP rule: DE-DE QSOs earn QSO point credit but NOT multiplier credit. DE counties (NDE/KDE/SDE) are kept in namedMults so the engine accepts the exchange as valid (and so the inStateMults filter for non-DE operators still works), but for DE operators we map any received DE county to a sentinel string that's NOT in namedMults — the downstream namedMults-membership check rejects it, so no mult is credited. Points are computed independently of this lookup, so they still apply per the byPrompt-driven 1/2/2 scale."
    }
  ],
  "logging": {
    "requiredFields": ["date", "time", "frequency", "mode", "callsign", "rstSent", "rstReceived", "exchSent", "exchReceived"],
    "cabrillo": {
      "version": "3.0",
      "contest": "DEQP",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}"
    }
  },
  "callHistory": {
    "fieldsToSave": ["EXCHr"],
    "description": "Save received exchange (county or state/province) for future lookups"
  },
  "validation": {
    "minimumQSOs": 1,
    "maxOperatingTime": 24,
    "offTimesRequired": false,
    "namedMults": [
      "NDE", "KDE", "SDE",

      "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "FL", "GA", "HI",
      "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA",
      "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM",
      "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD",
      "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY",

      "NS", "QC", "ON", "MB", "SK", "AB", "BC", "NT", "NB", "NL", "NU", "YT", "PE"
    ],
    "exchangeValidation": {
      "type": "multiplier",
      "description": "Exchange should be NDE/KDE/SDE for Delaware stations, a 2-letter US state or Canadian province code for non-Delaware W/VE, or DX. The DE state itself is not a multiplier (Delaware operators count 'states' meaning the OTHER 49)."
    },
    "receivedExchangeFilter": {
      "promptId": "stationType",
      "rules": {
        "OUTSIDE": "inStateMults",
        "DX":      "inStateMults"
      }
    },
    "inStateMults": [
      "NDE", "KDE", "SDE"
    ]
  },
  "ui": {
    "showMultiplierPanel": true,
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "RSTs", "RSTr", "EXCHs", "EXCHr", "POINTS", "M", "COMMENT"],
    "entryFields": ["CALL", "RSTr", "EXCHr"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["160m", "80m", "40m", "20m", "15m", "10m"]
    },
    "multiplierDisplay": {
      "showCounties": true,
      "showStates": true,
      "showProvinces": true,
      "showDXCC": true
    }
  }
}

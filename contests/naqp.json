  "exchangeFields": {
    "sent": [
      {
        "name": "RST",
        "type": "rst",
        "required": true,
        "description": "Signal report"
      },
      {
        "name": "NAMEs",
        "type": "string",
        "required": true,
        "description": "Operator first name sent"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "State/Province/Country sent"
      }
    ],
    "received": [
      {
        "name": "RST",
        "type": "rst",
        "required": false,
        "validation": "^[1-5][1-9][1-9]?$",
        "description": "Signal report (optional for export)"
      },
      {
        "name": "NAMEr",
        "type": "string",
        "required": true,
        "description": "Operator first name received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "State/Province/Country received (or DX)"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": ["CW", "SSB", "RTTY"],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RST_SENT",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Received",
      "column": "RST_RCV",
      "type": "string",
      "required": true
    },
    {
      "name": "Name Sent",
      "column": "NAMEs",
      "type": "string",
      "required": true,
      "description": "Operator first name sent"
    },
    {
      "name": "Name Received",
      "column": "NAMEr",
      "type": "string",
      "required": true,
      "description": "Operator first name received"
    },
    {
      "name": "QTH Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true,
      "description": "State/Province/Country sent"
    },
    {
      "name": "QTH Received",
      "column": "EXCHr",
      "type": "string",
      "required": true,
      "description": "State/Province/Country received (or DX)"
    },
    {
      "name": "Points",
      "column": "POINTS",
      "type": "number",
      "calculated": true
    },
    {
      "name": "Multiplier",
      "column": "M",
      "type": "string",
      "calculated": true
    }
  ],
  "scoring": {
    "points": {
      "sameDxccEntity": {
        "CW": 1,
        "SSB": 1,
        "RTTY": 1
      },
      "differentDxccEntity": {
        "CW": 1,
        "SSB": 1,
        "RTTY": 1
      }
    },
    "precedence": [
      "sameDxccEntity",
      "differentDxccEntity"
    ],
    "multipliers": {
      "type": "multsPerBand",
      "description": "US states, DC, Canadian provinces/territories, and other North American DXCC entities",
      "categories": ["namedMults"],
      "alaskaAndHawaiiCountDxcc": false,
      "usAndCanadaCountDxcc": false
    },
    "finalScore": "SUM(points) * SUM(multipliers)"
  },
  "dupeChecking": {
    "type": "perBand",
    "description": "Station may be worked once per band"
  },
  "logging": {
    "requiredFields": ["date", "time", "frequency", "mode", "callsign", "rstSent", "rstReceived", "nameSent", "nameReceived", "exchSent", "exchReceived"],
    "cabrillo": {
      "version": "3.0",
      "contest": "NAQP-CW",
      "contestMapping": {
        "CW": "NAQP-CW",
        "SSB": "NAQP-SSB",
        "RTTY": "NAQP-RTTY"
      },
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {name_sent} {exch_sent} {call} {name_rcvd} {exch_rcvd}"
    }
  },
  "callHistory": {
    "fieldsToSave": ["NAMEr", "EXCHr"],
    "description": "Save operator name and QTH for future lookups"
  },
  "validation": {
    "minimumQSOs": 10,
    "maxOperatingTime": 12,
    "offTimesRequired": true,
    "minimumOffTimeMinutes": 30,
    "namedMults": [
      "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY", "DC",
      "AB", "BC", "MB", "NB", "NL", "NT", "NS", "NU", "ON", "PE", "QC", "SK", "YT",
      "XE", "C6", "VP9", "J7", "HI", "FG", "OX", "FM", "VP2M", "PJ", "KP4", "J6", "VP5", "KP2", "VP2E", "V3", "TI", "YS", "7G", "HR", "6Y", "YN", "HP", "9Y"
    ],
    "exchangeValidation": {
      "type": "nameAndMultiplier",
      "description": "Name is any string; QTH should be a valid North American state/province/country or DX"
    }
  },
  "ui": {
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "RSTs", "RSTr", "NAMEs", "NAMEr", "EXCHs", "EXCHr", "POINTS", "M"],
    "entryFields": ["CALL", "NAMEr", "EXCHr"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["160m", "80m", "40m", "20m", "15m", "10m"]
    },
    "multiplierDisplay": {
      "showStates": true,
      "showProvinces": true,
      "showDXCC": false
    }
  }
}

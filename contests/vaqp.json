{
  "contest": {
    "name": "Virginia QSO Party",
    "abbreviation": "VAQP",
    "version": "1.0.0",
    "sponsor": "Sterling Park Amateur Radio Club (SPARC), Call Box 29, Sterling, VA 20167",
    "description": "Annual Virginia QSO Party. VA stations work all stations. Out-of-state stations work VA stations only. Work fixed stations once per band/mode; work VA Mobiles/Rovers/Expeditions once per county from which they operate.",
    "startDate": "Third Saturday in March (2026: March 21, 1400 UTC – March 22, 0400 UTC; then March 22, 1200 UTC – 2400 UTC)",
    "duration": 26,
    "offTimeGapMinutes": 0,
    "modes": ["CW", "SSB", "RTTY"],
    "bands": ["160m", "80m", "40m", "20m", "15m", "10m", "6m", "2m"],
    "url": "https://www.qsl.net/sterling/vaqp.htm",
    "categories": {
      "stations": ["SINGLE_OP", "MULTI_SINGLE", "MULTI_MULTI", "MOBILE", "EXPEDITION", "ROVER"],
      "power": ["QRP", "LOW_POWER", "HIGH_POWER"],
      "modes": ["MIXED", "CW", "PHONE", "DIGITAL"]
    }
  },

  "frequencies": {
    "160m": {
      "start": 1800,
      "end": 2000,
      "cw":    {"start": 1800, "end": 1840},
      "phone": {"start": 1840, "end": 2000}
    },
    "80m": {
      "start": 3500,
      "end": 4000,
      "cw":    {"start": 3500, "end": 3600},
      "phone": {"start": 3600, "end": 4000}
    },
    "40m": {
      "start": 7000,
      "end": 7300,
      "cw":    {"start": 7000, "end": 7125},
      "phone": {"start": 7125, "end": 7300}
    },
    "20m": {
      "start": 14000,
      "end": 14350,
      "cw":    {"start": 14000, "end": 14150},
      "phone": {"start": 14150, "end": 14350}
    },
    "15m": {
      "start": 21000,
      "end": 21450,
      "cw":    {"start": 21000, "end": 21200},
      "phone": {"start": 21200, "end": 21450}
    },
    "10m": {
      "start": 28000,
      "end": 29700,
      "cw":    {"start": 28000, "end": 28300},
      "phone": {"start": 28300, "end": 29700}
    },
    "6m": {
      "start": 50000,
      "end": 54000,
      "cw":    {"start": 50000, "end": 50125},
      "phone": {"start": 50125, "end": 54000}
    },
    "2m": {
      "start": 144000,
      "end": 148000,
      "cw":    {"start": 144000, "end": 144150},
      "phone": {"start": 144150, "end": 148000}
    }
  },

  "stationClasses": {
    "enabled": false
  },

  "userPrompts": [
    {
      "id": "stationType",
      "question": "Select your station location",
      "type": "select",
      "options": [
        {"value": "VA",  "label": "Virginia (in-state) — send VA county or independent city abbreviation"},
        {"value": "WVE", "label": "W/VE (US or Canada outside VA) — send state or province abbreviation"},
        {"value": "DX",  "label": "DX (outside US/Canada) — send DX"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Determines your sent exchange and which multipliers are counted."
    },
    {
      "id": "operatingClass",
      "question": "Select your operating class",
      "type": "select",
      "options": [
        {"value": "VA_SO",         "label": "VA: Single Operator"},
        {"value": "VA_MS",         "label": "VA: Multi-Op Single Transmitter"},
        {"value": "VA_MM",         "label": "VA: Multi-Op Multi Transmitter"},
        {"value": "VA_MOB",        "label": "VA: Mobile (vehicle-mounted, may operate while moving)"},
        {"value": "VA_EXP",        "label": "VA: Expedition (2+ VA locations, stationary at each, no commercial power)"},
        {"value": "VA_ROV",        "label": "VA: Rover (vehicle-mounted for contesting, stationary and/or moving)"},
        {"value": "OUT_SO",        "label": "Out-of-State: Single Operator"},
        {"value": "OUT_MS",        "label": "Out-of-State: Multi-Op Single Transmitter"},
        {"value": "OUT_MM",        "label": "Out-of-State: Multi-Op Multi Transmitter"},
        {"value": "DX_UNLIMITED",  "label": "DX: Unlimited"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "VA Mobiles/Expeditions/Rovers: contacts in each VA county/independent city they operate from are re-workable and count as a new multiplier."
    },
    {
      "id": "powerCategory",
      "question": "Select your power category",
      "type": "select",
      "options": [
        {"value": "QRP",  "label": "QRP — 5 watts or less"},
        {"value": "LOW",  "label": "Low Power — 150 watts or less"},
        {"value": "HIGH", "label": "High Power — greater than 150 watts"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "High power is greater than 150 watts; Low power is 150 watts or less."
    },
    {
      "id": "myExchange",
      "question": "Enter your exchange (VA county/city abbreviation, 2-letter state/province, or DX)",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "VA county or independent city abbreviation for VA stations (e.g. FAX for Fairfax Co., NFK for Norfolk). 2-letter US state or Canadian province for W/VE (e.g. MD, ON). DX for all others.",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    }
  ],

  "exchangeFields": {
    "sent": [
      {
        "name": "SNs",
        "type": "serial",
        "required": true,
        "description": "QSO serial number sent (auto-incremented)"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "VA county/independent city for VA stations; state/province for W/VE; DX for others"
      }
    ],
    "received": [
      {
        "name": "SNr",
        "type": "serial",
        "required": true,
        "description": "QSO serial number received"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": true,
        "description": "VA county/city (from VA stations), state/province (from W/VE), or DX"
      }
    ]
  },

  "qsoFields": [
    {"name": "Date",      "column": "DATE",   "type": "date",   "format": "yyyy-MM-dd", "required": true},
    {"name": "Time",      "column": "TIME",   "type": "time",   "format": "HH:mm:ss",   "required": true},
    {"name": "Callsign",  "column": "CALL",   "type": "string", "required": true, "uppercase": true},
    {"name": "Frequency", "column": "FREQ",   "type": "number", "unit": "kHz",    "required": true},
    {"name": "Mode",      "column": "MODE",   "type": "enum",   "values": ["CW", "SSB", "RTTY"], "required": true},
    {"name": "SN Sent",   "column": "SNs",    "type": "string", "required": true},
    {"name": "Exch Sent", "column": "EXCHs",  "type": "string", "required": true},
    {"name": "SN Rcvd",   "column": "SNr",    "type": "string", "required": true},
    {"name": "Exch Rcvd", "column": "EXCHr",  "type": "string", "required": true},
    {"name": "Points",    "column": "POINTS", "type": "number", "calculated": true},
    {"name": "Mult",      "column": "M",      "type": "string", "calculated": true}
  ],

  "scoring": {
    "points": {
      "phone": 1,
      "cw":    2,
      "digital": 2
    },
    "mobilePoints": 3,
    "mobileSuffixes": ["/M", "/R"],
    "multipliers": {
      "type": "multsOnce",
      "description": "VA stations: VA counties/independent cities + US states (excl VA) + Canadian provinces + DX — each counted once. Out-of-state stations: VA counties and independent cities only — each counted once.",
      "categories": ["namedMults"],
      "alaskaAndHawaiiCountDxcc": false,
      "usAndCanadaCountDxcc": false
    },
    "finalScore": "SUM(points) * SUM(multipliers)",
    "notes": [
      "Bonus points (add manually to claimed score):",
      "  VA Mobile/Expedition/Rover: +100 pts per VA county/independent city from which they log at least 10 valid QSOs."
    ]
  },

  "dupeChecking": {
    "type": "perBandAndMode",
    "description": "Work fixed stations once per band per mode. VA Mobile, Expedition, and Rover stations may be worked again in each new VA county or independent city they operate from."
  },

  "logging": {
    "requiredFields": ["date", "time", "frequency", "mode", "callsign", "serialSent", "exchSent", "serialRcvd", "exchReceived"],
    "cabrillo": {
      "version": "3.0",
      "contest": "VA-QSO-PARTY",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {sn_sent} {exch_sent} {call} {sn_rcvd} {exch_rcvd}",
      "requiredHeaders": ["CONTEST", "CALLSIGN", "CATEGORY-OPERATOR", "CATEGORY-POWER", "CATEGORY-MODE", "CLAIMED-SCORE", "CREATED-BY", "NAME", "EMAIL", "CLUB"]
    }
  },

  "callHistory": {
    "fieldsToSave": ["EXCHr"],
    "description": "Save county/state/province for future autofill"
  },


    "exchangeValidation": {
      "type": "multiplier",
      "description": "Kazakhstan stations send 3-character KDA district codes (1 letter + 2 digits, 212 total across 16 letter prefixes A/B/C/F/G/I/J/K/L/M/N/O/P/Q/T/Z). DX stations send 3-digit incrementing serial numbers. The engine recognizes KDA codes via namedMults; serial numbers fall through and the operator's DXCC entity (looked up from callsign) provides the country multiplier."
    }
  },
  "ui": {
    "showMultiplierPanel": true,
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "RSTs", "RSTr", "EXCHs", "EXCHr", "POINTS", "M", "COMMENT"],
    "entryFields": ["CALL", "RSTr", "EXCHr"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["80m", "40m", "20m", "15m", "10m"]
    },
    "multiplierDisplay": {
      "showCounties": true,
      "showStates": false,
      "showProvinces": false,
      "showDXCC": true
    }
  }
}

{
  "contest": {
    "name": "UN DX Contest",
    "abbreviation": "UN-DX",
    "version": "1.0.0",
    "sponsor": "Kazakhstan Federation of Radio Sports and Radioamateur",
    "description": "UN DX Contest — annual ~15-hour event sponsored by the Kazakhstan Federation of Radio Sports and Radioamateur. 16 May 2026, 0600Z to 2059Z. Kazakhstan stations work everyone; non-Kazakhstan stations work everyone (including own country and other DX). Exchange is RST + 3-character KDA district code (1 letter + 2 digits, e.g., L17 for Kostanay city) for Kazakhstan stations, or RST + serial number starting at 001 for everyone else. Asymmetric scoring: 10 pts for QSOs with Kazakhstan (any direction); 2 pts (DX op) or 10 pts (UN op) for own-country QSOs; 3 pts same-continent; 5 pts other-continent.",
    "startDate": "16 May 2026, 0600Z to 2059Z",
    "duration": 15,
    "offTimeGapMinutes": 0,
    "modes": ["CW", "SSB"],
    "bands": ["80m", "40m", "20m", "15m", "10m"],
    "url": "https://www.qrz.kz/contest/un-dx",
    "categories": {
      "stations": ["SINGLE_OP", "MULTI_OP", "SWL"],
      "power": ["LOW_POWER", "QRP", "HIGH_POWER"],
      "modes": ["MIXED", "CW", "SSB"]
    }
  },
  "contestOnlineScore": {
    "contestId": "UN-DX",
    "mult1Name": "KDA Districts / DXCC",
    "mult1Attribute": "exchange"
  },
  "frequencies": {
    "80m": {
      "start": 3500, "end": 3800,
      "cw":    {"start": 3500, "end": 3600},
      "phone": {"start": 3600, "end": 3800}
    },
    "40m": {
      "start": 7000, "end": 7200,
      "cw":    {"start": 7000, "end": 7040},
      "phone": {"start": 7040, "end": 7200}
    },
    "20m": {
      "start": 14000, "end": 14350,
      "cw":    {"start": 14000, "end": 14150},
      "phone": {"start": 14150, "end": 14350}
    },
    "15m": {
      "start": 21000, "end": 21450,
      "cw":    {"start": 21000, "end": 21200},
      "phone": {"start": 21200, "end": 21450}
    },
    "10m": {
      "start": 28000, "end": 29700,
      "cw":    {"start": 28000, "end": 28300},
      "phone": {"start": 28300, "end": 29700}
    }
  },
  "stationClasses": {
    "enabled": false
  },
  "userPrompts": [
    {
      "id": "stationType",
      "question": "Are you operating from Kazakhstan?",
      "type": "select",
      "options": [
        {"value": "UN", "label": "Kazakhstan (UN/UP — sends KDA district code)"},
        {"value": "DX", "label": "Outside Kazakhstan (sends serial number)"}
      ],
      "required": true,
      "storeInMeta": true,
      "description": "Kazakhstan stations send a 3-character KDA district code; everyone else sends a serial number starting at 001."
    },
    {
      "id": "operatingClass",
      "question": "Select your entry category",
      "type": "select",
      "options": [
        {"value": "SO_AB_MIX",  "label": "Single Op All Bands - MIXED"},
        {"value": "SO_AB_CW",   "label": "Single Op All Bands - CW"},
        {"value": "SO_AB_SSB",  "label": "Single Op All Bands - SSB"},
        {"value": "MO_AB_MIX",  "label": "Multi Op One Radio - MIXED (HP only)"},
        {"value": "SWL",        "label": "SWL"}
      ],
      "required": true,
      "storeInMeta": true
    },
    {
      "id": "myExchange",
      "question": "Enter your sent exchange. Kazakhstan stations: 3-character KDA district code (e.g., L17 for Kostanay city, A05 for Aktau city, G01 for Almaty Almalinskiy). DX stations: leave as 001 — the engine will auto-increment.",
      "type": "text",
      "required": true,
      "forceUppercase": true,
      "storeInMeta": true,
      "description": "KDA district code (Kazakhstan) or serial number (everyone else).",
      "exchangeFieldMapping": {
        "myExchange": "EXCHs"
      }
    }
  ],
  "exchangeFields": {
    "sent": [
      {"name": "RSTs",  "type": "rst",    "required": true,  "description": "Signal report sent"},
      {"name": "EXCHs", "type": "string", "required": true,  "description": "KDA district code (UN) or serial number (DX) sent"}
    ],
    "received": [
      {"name": "RSTr",  "type": "rst",    "required": true,  "description": "Signal report received"},
      {"name": "EXCHr", "type": "string", "required": true,  "description": "KDA district code (from UN) or serial number (from DX) received"}
    ]
  },
  "qsoFields": [
    {"name": "Date",      "column": "DATE",  "type": "date", "format": "yyyy-MM-dd", "required": true},
    {"name": "Time",      "column": "TIME",  "type": "time", "format": "HH:mm:ss",   "required": true},
    {"name": "Callsign",  "column": "CALL",  "type": "string", "required": true, "uppercase": true},
    {"name": "Frequency", "column": "FREQ",  "type": "number", "unit": "kHz", "required": true},
    {"name": "Mode",      "column": "MODE",  "type": "enum", "values": ["CW", "SSB"], "required": true},
    {"name": "RST Sent",     "column": "RSTs", "type": "rst", "required": true},
    {"name": "RST Received", "column": "RSTr", "type": "rst", "required": true},
    {"name": "Exchange Sent",     "column": "EXCHs", "type": "string", "required": true},
    {"name": "Exchange Received", "column": "EXCHr", "type": "string", "required": true},
    {"name": "Points",     "column": "POINTS", "type": "number", "calculated": true},
    {"name": "Multiplier", "column": "M",      "type": "string", "calculated": true}
  ],
  "scoring": {
    "points": {
      "partnerIsKazakhstan": {"CW": 10, "SSB": 10},
      "sameDxccEntity": {
        "CW": 2,
        "SSB": 2,
        "byPrompt": {
          "stationType": {
            "UN": {"CW": 10, "SSB": 10}
          }
        }
      },
      "sameContinent":      {"CW": 3, "SSB": 3},
      "differentContinent": {"CW": 5, "SSB": 5}
    },
    "partnerIsKazakhstanPrefixes": ["UN"],
    "scoringRuleConditions": {
      "partnerIsKazakhstan": {
        "promptId": "stationType",
        "values":   ["DX"]
      }
    },
    "precedence": [
      "partnerIsKazakhstan",
      "sameDxccEntity",
      "sameContinent",
      "differentContinent"
    ],
    "multipliers": {
      "type": "multsPerBand",
      "description": "Per-band multipliers: each unique KDA district contacted on a band, plus each unique DXCC entity contacted on a band. Both Kazakhstan and DX operators count both categories.",
      "categories": ["namedMults", "dxcc"],
      "alaskaAndHawaiiCountDxcc": true,
      "usAndCanadaCountDxcc": true
    },
    "finalScore": "SUM(points) * SUM(multipliers)"
  },
  "dupeChecking": {
    "type": "perBandAndMode",
    "description": "A station may be worked once per band per mode. Duplicates earn 0 points but should NOT be removed from the log — they help with log checking. Sponsor explicitly says 'DO NOT DELETE DUPES'."
  },
  "logging": {
    "requiredFields": ["date", "time", "frequency", "mode", "callsign", "rstSent", "rstReceived", "exchSent", "exchReceived"],
    "cabrillo": {
      "version": "3.0",
      "contest": "UN-DX",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}"
    }
  },
  "callHistory": {
    "fieldsToSave": ["EXCHr"],
    "description": "Save received exchange (KDA district code or serial number) for future lookups"
  },
  "validation": {
    "minimumQSOs": 1,
    "maxOperatingTime": 15,
    "offTimesRequired": false,
    "namedMults": [
      "A01", "A02", "A03", "A04", "A05", "A06",

      "description": "Exchange should be a 3-letter Arkansas county code for AR stations, a 2-letter US state or Canadian province code for non-AR W/VE, or DX for everyone outside USA/Canada. DC counts as MD via the namedMultAliases unconditional remap."
    },
    "receivedExchangeFilter": {
      "promptId": "stationType",
      "rules": {
        "OUTSIDE": "inStateMults",
        "DX":      "inStateMults"
      }
    },
    "inStateMults": [
      "ARK", "ASH", "BAX", "BEN", "BOO", "BRA", "CAL", "CAR", "CHI", "CLK",
      "CLA", "CLE", "CLV", "COL", "CON", "CRG", "CRA", "CRI", "CRO", "DAL",
      "DES", "DRE", "FAU", "FRA", "FUL", "GAR", "GNT", "GRE", "HEM", "HSP",
      "HOW", "IND", "IZA", "JAK", "JEF", "JON", "LAF", "LAW", "LEE", "LIN",
      "LRV", "LOG", "LON", "MAD", "MRN", "MIL", "MIS", "MON", "MGY", "NEV",

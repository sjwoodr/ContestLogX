      "RAN", "SFR", "SAL", "SCO", "SCY", "SEB", "SVR", "SHA", "STO", "UNI",
      "VBN", "WAS", "WHI", "WOO", "YEL",

      "AL", "AK", "AZ", "CA", "CO", "CT", "DE", "FL", "GA",

  "stationClasses": {
    "enabled": true,
    "prompt": "General Purpose DXCC Log",
    "classes": [
      {
        "id": "GENERAL_DXCC",
        "name": "General_Dxcc",
        "description": "General purpose logging",
        "needsInput": true,
        "promptForCallsign": true,
        "inputPrompts": {
          "id": "Enter your QTH (state/province/country)"
        },
        "exchangeFieldMapping": {
          "id": "EXCHs"
        },
        "inputValidation": {
          "id": {
            "forceUppercase": true
          }
        },
        "exchangeSent": {
          "type": "customInput"
        }
      }
    ]
  },
  "exchangeFields": {
    "sent": [
      {
        "name": "RST",
        "type": "rst",
        "required": true,
        "description": "Signal report"
      },
      {
        "name": "EXCHs",
        "type": "string",
        "required": true,
        "description": "QTH sent"
      },
      {
        "name": "NAMEs",
        "type": "string",
        "required": false,
        "description": "Operator name sent (optional)"
      }
    ],
    "received": [
      {
        "name": "RST",
        "type": "rst",
        "required": false,
        "validation": "^[1-5][1-9][1-9]?$",
        "description": "Signal report (optional)"
      },
      {
        "name": "EXCHr",
        "type": "string",
        "required": false,
        "description": "QTH received"
      },
      {
        "name": "NAMEr",
        "type": "string",
        "required": false,
        "description": "Operator name received (optional)"
      },
      {
        "name": "NOTES",
        "type": "string",
        "required": false,
        "description": "Comment (optional)"
      }
    ]
  },
  "qsoFields": [
    {
      "name": "Date",
      "column": "DATE",
      "type": "date",
      "format": "yyyy-MM-dd",
      "required": true
    },
    {
      "name": "Time",
      "column": "TIME",
      "type": "time",
      "format": "HH:mm:ss",
      "required": true
    },
    {
      "name": "Callsign",
      "column": "CALL",
      "type": "string",
      "required": true,
      "uppercase": true
    },
    {
      "name": "Frequency",
      "column": "FREQ",
      "type": "number",
      "unit": "kHz",
      "required": true
    },
    {
      "name": "Mode",
      "column": "MODE",
      "type": "enum",
      "values": ["CW", "SSB", "RTTY", "FT8", "FT4"],
      "required": true
    },
    {
      "name": "RST Sent",
      "column": "RST_SENT",
      "type": "string",
      "required": true,
      "default": "599"
    },
    {
      "name": "RST Received",
      "column": "RST_RCV",
      "type": "string",
      "required": true
    },
    {
      "name": "QTH Sent",
      "column": "EXCHs",
      "type": "string",
      "required": true,
      "description": "QTH sent"
    },
    {
      "name": "QTH Received",
      "column": "EXCHr",
      "type": "string",
      "required": true,
      "description": "QTH received"
    },
    {
      "name": "Name Sent",
      "column": "NAMEs",
      "type": "string",
      "required": false,
      "description": "Operator name sent (optional)"
    },
    {
      "name": "Name Received",
      "column": "NAMEr",
      "type": "string",
      "required": false,
      "description": "Operator name received (optional)"
    },
    {
      "name": "Comment",
      "column": "NOTES",
      "type": "string",
      "required": false,
      "description": "Comment (optional)"
    }
  ],
  "scoring": {
    "points": {
      "perQso": 1
    },
    "multipliers": {},
    "finalScore": "SUM(points)"
  },
  "dupeChecking": {
    "type": "perBandAndMode",
    "description": "Station may be worked once per band per mode"
  },
  "logging": {
    "requiredFields": ["date", "time", "frequency", "mode", "callsign", "rstSent", "rstReceived", "exchSent", "exchReceived"],
    "cabrillo": {
      "version": "3.0",
      "contest": "GENERAL-DXCC",
      "qsoTemplate": "QSO: {freq} {mode} {date} {time} {mycall} {rst_sent} {exch_sent} {call} {rst_rcvd} {exch_rcvd}"
    }
  },
  "callHistory": {
    "fieldsToSave": ["NAMEr", "EXCHr"],
    "description": "Save operator name and QTH for future lookups"
  },
  "validation": {
    "minimumQSOs": 0,
    "maxOperatingTime": 0,
    "offTimesRequired": false
  },
  "ui": {
    "logColumns": ["DATE", "TIME", "CALL", "FREQ", "MODE", "RSTs", "RSTr", "EXCHs", "EXCHr", "NAMEs", "NAMEr", "NOTES"],
    "entryFields": ["CALL", "RSTr", "EXCHr", "NAMEr", "NOTES"],
    "fieldNavigation": {
      "keys": "tab"
    },
    "bandMap": {
      "enabled": true,
      "bands": ["160m", "80m", "60m", "40m", "30m", "20m", "17m", "15m", "12m", "10m", "6m"]
    }
  }
}
